# ============================================================
# Primary model (required, OpenAI-compatible chat endpoint)
# ============================================================
MODEL_PROVIDER=openai_compatible
MODEL_REQUEST_URL=https://your-provider.example/v1/chat/completions
MODEL_REQUEST_TOKEN=replace-with-your-api-key
MODEL_NAME=your-model-name
MODEL_MAX_TOKENS=8192
MODEL_REQUEST_TIMEOUT=600
MODEL_REQUEST_RETRIES=4
MODEL_RETRY_BACKOFF_SECONDS=2

# Keep the autonomous Agent loop while enabling evidence, review, revision,
# visual planning, and delivery improvements.
SCIA_PIPELINE_VERSION=hybrid
SKIP_LEGACY_INTERNAL_REVIEW=true

# ============================================================
# Reviewer 1: methodology (optional)
# Leave URL/API_KEY/MODEL empty to reuse the primary model.
# ============================================================
METHOD_REVIEWER_URL=
METHOD_REVIEWER_API_KEY=
METHOD_REVIEWER_MODEL=
METHOD_REVIEWER_MAX_TOKENS=8192

# ============================================================
# Reviewer 2: experiment and evidence (optional)
# ============================================================
EXPERIMENT_REVIEWER_URL=
EXPERIMENT_REVIEWER_API_KEY=
EXPERIMENT_REVIEWER_MODEL=
EXPERIMENT_REVIEWER_MAX_TOKENS=8192

# ============================================================
# Reviewer 3: citation audit (optional)
# ============================================================
CITATION_REVIEWER_URL=
CITATION_REVIEWER_API_KEY=
CITATION_REVIEWER_MODEL=
CITATION_REVIEWER_MAX_TOKENS=8192

# ============================================================
# Reviewer 4: adversarial review (optional)
# ============================================================
ADVERSARIAL_REVIEWER_URL=
ADVERSARIAL_REVIEWER_API_KEY=
ADVERSARIAL_REVIEWER_MODEL=
ADVERSARIAL_REVIEWER_MAX_TOKENS=16000

# Reviewer runtime
V2_REVIEW_WORKERS=4
V2_REVIEW_PASS_SCORE=7
V2_REVIEW_MAX_TOKENS=6144
V2_REVIEW_TIMEOUT=600
V2_REVIEW_REVISION_ROUNDS=2
V2_REQUIRE_ALL_REVIEWERS=true
V2_REQUIRE_CITATION_AUDIT=true

# ============================================================
# Academic literature search
# Crossref/OpenAlex need no API key. ScienceDirect is skipped when the
# optional Elsevier credentials are empty.
# ============================================================
V2_ACADEMIC_SEARCH=true
ACADEMIC_SEARCH_SOURCES=crossref,openalex,sciencedirect
ACADEMIC_SEARCH_MAILTO=
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
V2_ALWAYS_WEB_SEARCH=false

# Optional credentials used by configured MCP search/crawler tools
SEARCH_ENGINE_API_KEYS=
URL_CRAWLER_API_KEYS=

# ============================================================
# Experiment archive import and visual planning
# ============================================================
ARCHIVE_MAX_FILES=10000
ARCHIVE_MAX_EXPANDED_MB=4096
V2_EXPERIMENTS_PER_SECTION=30
FIGURE_AGENT_USE_PRIMARY_MODEL=true
VISUAL_PLANNER_USE_PRIMARY_MODEL=true

# ============================================================
# Web application database and session signing
# Generate a unique long random SECRET_KEY for every deployment.
# ============================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sciassistant
SECRET_KEY=replace-with-a-long-random-string

# ============================================================
# Local MCP server
# ============================================================
MCP_SERVER_URL=http://localhost:6274/mcp/
MCP_AUTH_TOKEN=
MCP_USE_STDIO=false
